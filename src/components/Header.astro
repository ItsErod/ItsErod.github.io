---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="#top">{site.name}</a>
    <nav id="site-nav" class="nav" aria-label="Primary">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="bar-end">
      <ThemeToggle />
      <button
        id="menu-button"
        class="menu-button icon-button"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <svg class="icon-menu" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("#site-nav");
  const button = document.querySelector<HTMLButtonElement>("#menu-button");

  if (nav && button) {
    const setOpen = (open: boolean): void => {
      nav.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    const desktop = window.matchMedia("(min-width: 760px)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
